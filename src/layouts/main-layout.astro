---
import { ClientRouter } from "astro:transitions";
import { Logo } from "@/components/shared/logo";

import "@/styles/global.css";

interface Props {
	title?: string;
	variant?: "default" | "error";
}

const { title = "Michał Mackowiak", variant } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#000000" />
        <title>{title}</title>
        <meta
            name="description"
            content="Web developer building yet another button component, wannabe landscape photographer still figuring out what the camera buttons do, traveler trying to see the world. Powered by good coffee and late-night gaming."
        />
    </head>
    <body class="bg-background p-2">
        <div class="flex flex-col text-foreground h-full bg-surface rounded-[40px] md:rounded-2xl">
            <header class="flex place-items-center justify-center h-24 min-h-24">
                <a
                    href="/"
                    aria-label="Home"
                    class="p-1 focus-visible:ogar-ring-surface"
                >
                    <Logo className="size-10 z-2001 relative" variant={variant === "error" ? "broken" : "default"}  />
                </a>
            </header>
            <main class="flex-1 flex justify-center place-items-center p-8">
                <slot />
            </main>
            <footer
                class="flex place-items-center justify-center h-24 min-h-24 text-center text-sm text-muted-foreground relative z-2001"
            >
                © Michał Maćkowiak
            </footer>
        </div>
    </body>
</html>

<ClientRouter />
