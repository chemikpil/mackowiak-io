---
import { InstagramIcon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import { Carousel } from "@/components/carousel";
import { Link } from "@/components/ui/link";
import MainLayout from "@/layouts/main-layout.astro";
---

<MainLayout title="Photography | Michał Mackowiak">
    <article class="flex flex-col gap-6 max-w-104 w-full">
        <header class="flex gap-4 justify-between items-center ">
            <h1 class="text-2xl font-semibold">Recent photos</h1>
            <Link variant="tertiary" href="https://www.instagram.com/chemikpil/" target="_blank">
                <HugeiconsIcon icon={InstagramIcon} size={16} />
                Instagram
            </Link>
        </header>
        <Carousel client:load />
    </article>
</MainLayout>   